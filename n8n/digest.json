{
  "name": "Daily Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "d1000000-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value FROM settings WHERE key = 'digest_time'",
        "options": {}
      },
      "id": "d1000000-0001-4000-8000-000000000002",
      "name": "PostgreSQL: Get Digest Time",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 300],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// digest_time stored as HH:MM, timezone is MSK (UTC+3)\nconst digestTime = $input.first().json.value || '09:00';\nconst now = new Date();\nconst mskOffset = 3 * 60; // UTC+3 in minutes\nconst utcMinutes = now.getUTCHours() * 60 + now.getUTCMinutes();\nconst mskMinutes = (utcMinutes + mskOffset) % (24 * 60);\nconst mskHours = Math.floor(mskMinutes / 60);\nconst mskMins = mskMinutes % 60;\nconst currentTime = `${String(mskHours).padStart(2, '0')}:${String(mskMins).padStart(2, '0')}`;\n\nreturn [{ json: { digestTime, currentTime, isMatch: currentTime === digestTime } }];"
      },
      "id": "d1000000-0001-4000-8000-000000000003",
      "name": "Code: Check Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-time-match",
              "leftValue": "={{ $json.isMatch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1000000-0001-4000-8000-000000000004",
      "name": "IF: Time Matches",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, text, date, link, source_channel FROM news WHERE created_at > NOW() - INTERVAL '24 hours' ORDER BY date DESC",
        "options": {}
      },
      "id": "d1000000-0001-4000-8000-000000000005",
      "name": "PostgreSQL: Get News 24h",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1140, 300],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-news",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1000000-0001-4000-8000-000000000006",
      "name": "IF: Has News",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TG_CHAT_ID || '' }}",
        "text": "Нет новостей за последние 24 часа.",
        "additionalFields": {}
      },
      "id": "d1000000-0001-4000-8000-000000000012",
      "name": "Telegram: No News",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1580, 500],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.all().map(i => i.json);\nreturn [{ json: { posts: JSON.stringify(posts) } }];"
      },
      "id": "d1000000-0001-4000-8000-000000000007",
      "name": "Code: Prepare Posts for AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "sendMessage",
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "=Ты — редактор новостного дайджеста. Тебе дан массив новостных постов.\n\nЗадача: для каждого поста напиши краткое описание в 2-3 предложения. Сохрани ключевую суть и факты, убери воду и рекламу.\n\nПосты:\n{{ $json.posts }}\n\nВерни JSON-массив объектов с полями: \"id\", \"summary\", \"link\", \"source_channel\". Не добавляй пояснений, только JSON."
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "response_format": "json_object"
        }
      },
      "id": "d1000000-0001-4000-8000-000000000008",
      "name": "OpenAI: Summarize",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [1800, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || $input.first().json.text || '';\nlet items;\ntry {\n  const parsed = JSON.parse(raw);\n  items = Array.isArray(parsed) ? parsed : (parsed.items || parsed.posts || parsed.results || []);\n} catch (e) {\n  items = [];\n}\n\nconst now = new Date();\nconst mskOffset = 3 * 60;\nconst mskTime = new Date(now.getTime() + mskOffset * 60000);\nconst dateStr = `${String(mskTime.getUTCDate()).padStart(2, '0')}.${String(mskTime.getUTCMonth()+1).padStart(2, '0')}.${mskTime.getUTCFullYear()}`;\n\nlet message = `Дайджест за ${dateStr}\\n`;\n\nfor (const item of items) {\n  message += `\\nid: ${item.id}\\n${item.summary}\\nlink: ${item.link}\\n`;\n}\n\nreturn [{ json: { message } }];"
      },
      "id": "d1000000-0001-4000-8000-000000000009",
      "name": "Code: Build Digest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2020, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TG_CHAT_ID || '' }}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "d1000000-0001-4000-8000-000000000010",
      "name": "Telegram: Send Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2240, 300],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot API"
        }
      }
    }
  ],
