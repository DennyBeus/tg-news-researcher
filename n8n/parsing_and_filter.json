      "id": "c1000000-0001-4000-8000-000000000002",
      "name": "PostgreSQL: Get Channels",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 300],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-channels-exist",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1000000-0001-4000-8000-000000000010",
      "name": "IF: Has Channels",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst urls = items.map(i => i.json.url).filter(Boolean);\n\nif (urls.length === 0) {\n  return [{ json: { command: '' } }];\n}\n\n// Start date = now minus schedule interval (4h) minus 1h buffer = 5h ago\nconst now = new Date();\nconst startDate = new Date(now.getTime() - 5 * 60 * 60 * 1000);\nconst pad = (n) => String(n).padStart(2, '0');\nconst startStr = `${startDate.getFullYear()}-${pad(startDate.getMonth()+1)}-${pad(startDate.getDate())} ${pad(startDate.getHours())}:${pad(startDate.getMinutes())}:${pad(startDate.getSeconds())}`;\n\nconst channelArgs = urls.join(' ');\nconst command = `cd /path/to/tg-news-researcher && python parser/run.py --stdout -f json -j -s \"${startStr}\" ${channelArgs}`;\n\nreturn [{ json: { command } }];"
      },
      "id": "c1000000-0001-4000-8000-000000000003",
      "name": "Code: Build Parser Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "command": "={{ $json.command }}"
      },
      "id": "c1000000-0001-4000-8000-000000000004",
      "name": "Execute Command: Parser",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nif (!raw || raw.trim() === '' || raw.trim() === '[]') {\n  return [];\n}\ntry {\n  const posts = JSON.parse(raw);\n  return posts.map(p => ({ json: p }));\n} catch (e) {\n  return [];\n}"
      },
      "id": "c1000000-0001-4000-8000-000000000005",
      "name": "Code: Parse stdout JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 300]
    },
