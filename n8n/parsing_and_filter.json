          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const interests = $('PostgreSQL: Get Interests').all().map(i => i.json.text);\nconst posts = $('Code: Parse stdout JSON').all().map(i => i.json);\n\nreturn [{ json: { interests, posts } }];"
      },
      "id": "c1000000-0001-4000-8000-000000000012",
      "name": "Code: Merge Posts and Interests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2020, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "sendMessage",
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "=Ты — фильтр новостей. Тебе дан список интересов пользователя и массив постов из Telegram-каналов.\n\nЗадача: отобрать только те посты, которые соответствуют хотя бы одному интересу. Соответствие определяй по смыслу, а не по точному совпадению слов.\n\nИнтересы:\n{{ $json.interests }}\n\nПосты:\n{{ JSON.stringify($json.posts) }}\n\nВерни JSON-массив подходящих постов. Каждый объект — точная копия исходного поста без изменений. Если ни один пост не подходит — верни пустой массив []. Не добавляй пояснений, только JSON."
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "response_format": "json_object"
        }
      },
      "id": "c1000000-0001-4000-8000-000000000007",
      "name": "OpenAI: Filter by Interests",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [2240, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || $input.first().json.text || '';\ntry {\n  let parsed = JSON.parse(raw);\n  const posts = Array.isArray(parsed) ? parsed : (parsed.posts || parsed.results || []);\n  if (posts.length === 0) return [];\n  return posts.map(p => ({ json: p }));\n} catch (e) {\n  return [];\n}"
      },
      "id": "c1000000-0001-4000-8000-000000000008",
      "name": "Code: Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO news (text, date, views, reactions_count, link, source_channel)\nVALUES\n{{ $input.all().map(item => {\n  const j = item.json;\n  const text = (j.text || '').replace(/'/g, \"''\");\n  const link = (j.link || '').replace(/'/g, \"''\");\n  const source = (j.source_channel || '').replace(/'/g, \"''\");\n  return `('${text}', '${j.date}', ${j.views || 0}, ${j.reactions_count || 0}, '${link}', '${source}')`;\n}).join(',\\n') }}\nON CONFLICT (link) DO NOTHING",
        "options": {}
      },
